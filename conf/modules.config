/*
 * nf-ontmeth module-specific publishDir configuration
 */

process {
    withName: 'SMOOTH_ATLAS' {
        publishDir = [
            path: { "${params.outdir}/atlas" },
            mode: 'copy',
            pattern: '*.tsv.gz'
        ]
    }

    withName: 'DETECT_CPG_ISLANDS' {
        publishDir = [
            path: { "${params.outdir}/cpg_islands" },
            mode: 'copy',
            pattern: '*.bed'
        ]
    }

    withName: 'DETECT_DMR' {
        publishDir = [
            path: { "${params.outdir}/dmr" },
            mode: 'copy',
            pattern: '*.tsv'
        ]
    }

}
