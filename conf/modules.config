/*
 * DMRdetector module-specific publishDir configuration
 */

process {
    withName: 'SMOOTH_ATLAS' {
        publishDir = [
            path: { "${params.outdir}/atlas" },
            mode: 'copy',
            pattern: '*.tsv.gz'
        ]
    }

    withName: 'DETECT_CPG_ISLANDS' {
        publishDir = [
            path: { "${params.outdir}/cpg_islands" },
            mode: 'copy',
            pattern: '*.bed'
        ]
    }

    withName: 'INFER_SEX_FROM_VCF' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info/sex_inference" },
            mode: 'copy',
            pattern: '*_sex_inference.tsv'
        ]
    }

    withName: 'ANNOTATE_DMRS' {
        publishDir = [
            path: { "${params.outdir}/dmr" },
            mode: 'copy',
            pattern: '*.tsv'
        ]
    }

}
