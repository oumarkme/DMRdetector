/*
 * nf-ontmeth base resource configuration
 *
 * Local execution only (Linux, WSL2, macOS).
 */

process {
    cpus   = { check_max( 2, 'cpus' ) }
    memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    time   = { check_max( 24.h * task.attempt, 'time' ) }

    errorStrategy = { task.exitStatus in [137, 140, 143, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    beforeScript = {
        def cmds = []
        if (params.tmp_dir) {
            cmds << "export TMPDIR='${params.tmp_dir}' TMP='${params.tmp_dir}' TEMP='${params.tmp_dir}'; mkdir -p '${params.tmp_dir}'"
        }
        // Cap all threading libraries to task.cpus (works on Linux, macOS, WSL)
        cmds << "export OMP_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus}"
        cmds.join('; ')
    }

    withLabel: 'light' {
        cpus   = { check_max( 1, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }

    withLabel: 'standard' {
        cpus   = { check_max( 2, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }

    withLabel: 'medium' {
        cpus   = { check_max( 4, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
    }

    withLabel: 'heavy' {
        cpus   = { check_max( 10, 'cpus' ) }
        memory = { check_max( 100.GB * task.attempt, 'memory' ) }
    }
}
