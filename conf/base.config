/*
 * DMRdetector base resource configuration
 *
 * Local execution only (Linux, WSL2, macOS).
 */

process {
    cpus   = { Math.min( 2, params.max_cpus as int ) }
    memory = { [(16.GB * task.attempt), (params.max_memory as nextflow.util.MemoryUnit)].min() }
    time   = { [(24.h * task.attempt), (params.max_time as nextflow.util.Duration)].min() }

    errorStrategy = { task.exitStatus in [137, 140, 143, 139] ? 'retry' : 'finish' }
    maxRetries    = 2

    beforeScript = {
        def cmds = []
        def td = params.tmp_dir ?: "${params.outdir}/tmp"
        cmds << "mkdir -p '${td}'; export TMPDIR='${td}' TMP='${td}' TEMP='${td}'"
        // Cap all threading libraries to task.cpus (works on Linux, macOS, WSL)
        cmds << "export OMP_NUM_THREADS=${task.cpus} OPENBLAS_NUM_THREADS=${task.cpus} MKL_NUM_THREADS=${task.cpus}"
        cmds.join('; ')
    }

    withLabel: 'light' {
        cpus   = { Math.min( 1, params.max_cpus as int ) }
        memory = { [(4.GB * task.attempt), (params.max_memory as nextflow.util.MemoryUnit)].min() }
    }

    withLabel: 'standard' {
        cpus   = { Math.min( 2, params.max_cpus as int ) }
        memory = { [(16.GB * task.attempt), (params.max_memory as nextflow.util.MemoryUnit)].min() }
    }

    withLabel: 'medium' {
        cpus   = { Math.min( 4, params.max_cpus as int ) }
        memory = { [(32.GB * task.attempt), (params.max_memory as nextflow.util.MemoryUnit)].min() }
    }

    withLabel: 'heavy' {
        cpus   = { Math.min( 10, params.max_cpus as int ) }
        memory = { [(100.GB * task.attempt), (params.max_memory as nextflow.util.MemoryUnit)].min() }
    }
}
