/*
 * DMRdetector: ONT Methylation Analysis Pipeline
 *
 * Configuration for DMR detection from Oxford Nanopore WGS data.
 * Runs natively inside the bundled conda environment (see environment.yml);
 * no Docker or Apptainer required.
 */

// ============================================================================
// Parameters
// ============================================================================

params {
    // --- Input/Output ---
    input           = null       // Samplesheet CSV (required): sample_id, type, meth_bed, vcf
    outdir          = './results'

    // --- Pre-computed references (skip Stages 1-2 if provided) ---
    ref_atlas         = null     // Pre-built autosomal reference atlas (tsv.gz)
    cpg_panel         = null     // Optional pre-built autosomal CpG island panel (bed)
    // Sex-stratified pre-built references — reused when all three atlases AND
    // include_sex_chromosomes=true are supplied; otherwise fall back to
    // autosomes-only skip mode.
    ref_atlas_male_X  = null
    ref_atlas_female_X= null
    ref_atlas_Y       = null
    cpg_panel_male_X  = null
    cpg_panel_female_X= null
    cpg_panel_Y       = null

    // --- ICR panel (enabled by default) ---
    icr_panel                   = null   // Optional ICR BED override; otherwise built from atlas
    icr_gene_list               = null   // Optional imprinting gene BED override; defaults to assets/icr_gene_list.bed
    icr_ref_meth_min            = 0.35
    icr_ref_meth_max            = 0.65
    icr_diff_threshold          = 0.25
    icr_min_sites               = 5

    // --- Reference Atlas Building (Stage 1) ---
    atlas_min_samples_per_site  = 3
    atlas_min_read_coverage     = 5
    atlas_shrinkage_weight      = 0.1

    // --- FFT Gaussian Smoothing ---
    smooth_sigma_narrow         = 150
    smooth_sigma_wide           = 500

    // --- CpG Island Detection (Stage 2) ---
    cpg_min_samples_per_site    = 5
    cpg_core_max_methylation    = 0.1
    cpg_core_max_dispersion     = 0.05
    cpg_shore_max_methylation   = 0.3
    cpg_max_gap_distance        = 150
    cpg_min_island_length       = 150

    // --- DMR Detection (Stage 3) ---
    dmr_min_coverage            = 10
    dmr_cpg_diff_threshold      = 0.40
    dmr_merge_distance          = 150
    dmr_fdr_threshold           = 0.01
    dmr_cpg_min_sites           = 30

    // --- Chromosome filtering ---
    // Autosomes (1-22) are always included. When enabled (default), the
    // pipeline reads sex from the samplesheet and builds component
    // references for autosomal, non-PAR male_X, non-PAR female_X, and Y
    // scopes. Set to false to restrict analysis to autosomes.
    include_sex_chromosomes     = true

    // --- Sex chromosome handling (active when include_sex_chromosomes=true) ---
    // Sex is supplied per sample in the samplesheet (M/F column).
    par_bed                     = null       // Override built-in hg38 PAR coords if set
    sex_atlas_min_controls      = 3          // Per-sex minimum CTRL count for sex-specific scopes

    // --- Female chrX model ---
    // Used for the female_X hemi-methylated CpG island model and relaxed
    // female_X DMR thresholds.
    sex_f_ref_meth_min          = 0.40
    sex_f_ref_meth_max          = 0.60
    sex_f_diff_threshold        = 0.25
    sex_f_min_sites             = 5

    // --- Temporary directory (defaults to outdir if not set) ---
    tmp_dir                     = null

    // --- Resource limits (auto-detected: 80% of system) ---
    max_memory = {
        try {
            def os = System.getProperty('os.name').toLowerCase()
            if (os.contains('mac')) {
                def proc = ['sysctl', '-n', 'hw.memsize'].execute()
                proc.waitFor()
                def bytes = proc.text.trim() as long
                "${Math.max(1, (int)(bytes / 1073741824 * 0.8))}.GB"
            } else {
                def m = new File('/proc/meminfo').text
                def kb = (m =~ /MemTotal:\s+(\d+)/)[0][1] as long
                "${Math.max(1, (int)(kb / 1048576 * 0.8))}.GB"
            }
        } catch (_all) { '64.GB' }
    }()
    // Cap CPUs by both core count (80%) and available RAM (1 CPU per 4 GB).
    // On a 30 GB / 8 CPU system: min(6, 6) = 6 CPUs.
    // On a 16 GB / 8 CPU system: min(6, 3) = 3 CPUs.
    max_cpus   = {
        def cpu80 = Math.max(1, (int)(Runtime.runtime.availableProcessors() * 0.8))
        def mem_gb = (params.max_memory.toString().replaceAll(/[^0-9.]/, '') as double)
        def ram_cpus = Math.max(1, (int)(mem_gb / 4))
        Math.min(cpu80, ram_cpus)
    }()
    max_time   = '168.h'

    // --- Help ---
    help = false
}

// ============================================================================
// Includes
// ============================================================================

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ============================================================================
// Work directory — use tmp_dir for faster local I/O when inputs are on NAS
// ============================================================================

workDir = params.tmp_dir
    ? "${params.tmp_dir}/work"
    : "${params.outdir}/work"

// ============================================================================
// Executor — enforce total resource pool for local execution
// ============================================================================

executor {
    name   = 'local'
    cpus   = params.max_cpus
    memory = params.max_memory
}

// ============================================================================
// Profiles
// ============================================================================

profiles {
    test {
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '1.h'
    }
}

// ============================================================================
// Manifest
// ============================================================================

manifest {
    name            = 'DMRdetector'
    author          = 'Jen-Hsiang (Mark) Ou'
    description     = 'ONT Methylation Analysis Pipeline — DMR detection from Oxford Nanopore WGS'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '2.2'
}

// ============================================================================
// Reports
// ============================================================================

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/nf_report.html"
}
